# Application — Frontend (Next.js)
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000

# Application — API (FastAPI)
APP_NAME="Recipe AI System API"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Database (matches Docker Compose configuration)
DATABASE_URL=postgresql+asyncpg://recipe_user:recipe_password@localhost:5432/recipe_ai
ALEMBIC_DATABASE_URL=postgresql+psycopg://recipe_user:recipe_password@localhost:5432/recipe_ai
POSTGRES_USER=recipe_user
POSTGRES_PASSWORD=recipe_password
POSTGRES_DB=recipe_ai

# LLM / AI
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# LangSmith (LLM Tracing)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=recipe-ai-system-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# OpenTelemetry
# IMPORTANT: this is the OTLP **HTTP** receiver on Tempo (port 4318).
# The API uses the OTLP HTTP exporter; do not point it at 4317 (gRPC).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=recipe-api
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Tempo (Tracing)
TEMPO_ENDPOINT=http://localhost:3200

# Loki (Logging)
LOKI_ENDPOINT=http://localhost:3100

# FastAPI
API_HOST=0.0.0.0
API_PORT=4000
API_RELOAD=true

# USDA FoodData Central (optional — improves nutrition accuracy)
# Get a free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=
USDA_API_BASE_URL=https://api.nal.usda.gov/fdc/v1

# Production safety
LLM_TIMEOUT_SECONDS=30.0
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=10