{
  "version": "1.0",
  "description": "Golden QA set for RAG retrieval quality evaluation. Each entry pairs a natural-language query with the recipe names that should appear in the top-K results. Queries are designed to test cuisine matching, ingredient overlap, dietary filtering, meal-type awareness, and semantic (non-keyword) understanding.",
  "k": 5,
  "thresholds": {
    "precision_at_k": 0.40,
    "recall_at_k": 0.55,
    "mrr": 0.55
  },
  "queries": [
    {
      "id": "q01",
      "description": "Cuisine + ingredient signal — Central Asian plov",
      "query": "Central Asian rice pilaf with meat for dinner",
      "expected_recipes": ["Chicken Plov", "Beef Plov"],
      "filters": {}
    },
    {
      "id": "q02",
      "description": "Meal-type + category — lunch soups",
      "query": "warm soup for a weekday lunch",
      "expected_recipes": ["Lentil Soup", "Chicken Noodle Soup"],
      "filters": {}
    },
    {
      "id": "q03",
      "description": "Meal-type — breakfast eggs",
      "query": "quick protein-rich breakfast with eggs",
      "expected_recipes": ["Egg Breakfast Plate", "Shakshuka"],
      "filters": {}
    },
    {
      "id": "q04",
      "description": "Ingredient signal — noodle dishes",
      "query": "dinner with noodles or pasta",
      "expected_recipes": ["Lagman-style Noodles", "Spaghetti Bolognese"],
      "filters": {}
    },
    {
      "id": "q05",
