+"""
+USDA Nutrition MCP Server.
+
+Exposes USDA FoodData Central as MCP tools so agents can retrieve
+authoritative per-100 g nutrient values to ground their LLM estimates.
+
+Transport: stdio (spawned as a subprocess by NutritionAgent).
+
+Run standalone:
+    python apps/api/app/mcp_server.py
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+# Allow `python apps/api/app/mcp_server.py` (direct invocation) to find the
+# app package without requiring the caller to set PYTHONPATH.
+sys.path.insert(0, str(Path(__file__).parent.parent))
+
+from mcp.server.fastmcp import FastMCP
+
+from app.observability import get_logger
+from app.services.nutrition_data_service import NutritionDataService
+
+logger = get_logger(__name__)
+
+mcp = FastMCP("usda-nutrition")
+
+# USDA nutrient display name → field key returned by get_ingredient_nutrients
+_NUTRIENT_MAP: dict[str, str] = {
+    "Energy": "calories_kcal",
+    "Protein": "protein_g",
+    "Total lipid (fat)": "fat_g",
+    "Carbohydrate, by difference": "carbs_g",
+    "Fiber, total dietary": "fiber_g",
+    "Sugars, total including NLEA": "sugar_g",
+    "Sodium, Na": "sodium_mg",
+}
+
+
+@mcp.tool()
+async def search_food(query: str, page_size: int = 5) -> list[dict]:
+    """
+    Search USDA FoodData Central for foods matching a free-text query.
+    Returns up to page_size result dicts with fdcId, description, dataType, etc.
+    """
+    async with NutritionDataService() as svc:
+        results = await svc.search_food(query, page_size=page_size)
+    logger.info("mcp_search_food", extra={"query": query, "results": len(results)})
+    return results
+
+
+@mcp.tool()
+async def get_ingredient_nutrients(ingredient_name: str) -> dict:
+    """
+    Look up per-100 g macro nutrients for an ingredient in USDA FoodData Central.
+
+    Combines a search and a detail lookup in one call. Returns a dict with any
+    subset of: calories_kcal, protein_g, fat_g, carbs_g, fiber_g, sugar_g,
+    sodium_mg. Returns {} when the ingredient is not found or USDA is
+    unavailable (e.g. USDA_API_KEY not set).
+    """
+    try:
+        async with NutritionDataService() as svc:
+            foods = await svc.search_food(ingredient_name, page_size=1)
+            if not foods:
+                return {}
+            fdc_id = str(foods[0].get("fdcId", ""))
+            if not fdc_id:
+                return {}
+            details = await svc.get_food_details(fdc_id)
+
+        nutrients: dict[str, float] = {}
+        for item in details.get("foodNutrients", []):
+            nutrient_info = item.get("nutrient", {})
+            name = nutrient_info.get("name", "")
+            if name in _NUTRIENT_MAP:
+                amount = item.get("amount")
+                if amount is not None:
+                    nutrients[_NUTRIENT_MAP[name]] = round(float(amount), 2)
+
+        logger.info(
+            "mcp_get_ingredient_nutrients",
+            extra={"ingredient": ingredient_name, "fields": list(nutrients.keys())},
+        )
+        return nutrients
+    except Exception as exc:
+        logger.warning(
+            "mcp_get_ingredient_nutrients_failed",
+            extra={"ingredient": ingredient_name, "reason": str(exc)},
+        )
+        return {}
+
+
+if __name__ == "__main__":
+    mcp.run()
